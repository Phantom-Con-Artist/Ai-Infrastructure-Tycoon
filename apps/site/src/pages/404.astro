---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---
<Layout title="Page not found | AI Infrastructure Tycoon" cta={false}>
  <section class="phero">
    <div class="wrap">
      <h1 class="h1" data-rise>This rack is <em>empty</em></h1>
      <p class="lead" data-rise>There is no page at this address. It may have moved, or it may never have been installed.</p>
      <div class="btn-row" style="margin-top:28px" data-rise>
        <a class="btn" href="/">Back to the start <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="/docs">Documentation</a>
      </div>
    </div>
  </section>
</Layout>
