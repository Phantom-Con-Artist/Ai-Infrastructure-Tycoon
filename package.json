{
  "name": "ai-infrastructure-tycoon",
  "productName": "AI Infrastructure Tycoon",
  "version": "0.1.0-beta",
  "description": "A light 3D management game about building data centers, wrangling power and cooling, designing chips and training models. Parody universe, real physics.",
  "author": "Phantom-Con Artist",
  "license": "MIT",
  "homepage": "https://github.com/Phantom-Con-Artist/Ai-Infrastructure-Tycoon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phantom-Con-Artist/Ai-Infrastructure-Tycoon.git"
  },
  "bugs": {
    "url": "https://github.com/Phantom-Con-Artist/Ai-Infrastructure-Tycoon/issues"
  },
  "keywords": [
    "game",
    "tycoon",
    "electron",
    "threejs",
    "simulation",
    "data-center",
    "gpu",
    "management-game"
  ],
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "web": "vite --config vite.web.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/player": "^4.0.542",
    "better-sqlite3": "^13.0.3",
    "immer": "^11.2.9",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "simple-icons": "^16.37.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.phantomconartist.aiinfratycoon",
    "productName": "AI Infrastructure Tycoon",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "resources/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.simulation-games"
    }
  }
}
