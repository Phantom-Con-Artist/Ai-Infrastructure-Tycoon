  "description": "AI Infrastructure Tycoon - build datacenters, power grids and GPU clusters, train and sell AI.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
